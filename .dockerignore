# 排除用户配置（含账号信息，由运行时挂载）
config.yaml
config/config.yaml

# 排除本地数据库与日志
*.db
*.db-shm
*.db-wal
logs/
assets/log/
assets/logs/
assets/sound/
assets/faces/
assets/fsces/

# 排除大型开发/中间文件
