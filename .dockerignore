questions.json
questions_answers.json.bak_*
*.bak_*

# 排除构建产物与日志
build/
build_stage/
dist/
yatori_build.spec
build_log.txt
protected_build_log.txt

# 排除无关内容
.git
.gitignore
.github
.idea
.vscode
__pycache__/
*.py[cod]
yatori-go-quesbank-main/
README.md
